FORM SECREEN_1000_ADD_CBTN.
    
    PERFORM CREATE_ICON_1000.
    
    PERFORM IMPORT_MEMORY_1000.
    
    PERFORM GET_VARIANT_DATA.
    
    PERFORM SET_VARIANT_LIST USING GV_SCRNAME.

    PERFORM MAKE_GT_COLUMNS.
ENDFORM.

FORM ICON_CREATE USING PV_NAME PV_TEXT PV_INFO PV_RESULT.
    CALL FUNCTION 'ICON_CREATE'
        EXPORTING
            NAME = PV_NAME
            TEXT = PV_TEXT
            INFO = PV_INFO
            ADD_STDINF = ' '
        IMPORTING  
            RESULT = PV_RESULT
        EXCEPTIONS
            ...
ENDFORM.

FORM GET_VARIANT_dATA.
    CLEAR : GT_TKESS_sCR, GT_TKESS_SCR_DESCR, GT_TKESS_SCR_FIELD.

    SELECT PRGNAME TABNAME SCRNAME USER_SPEC
           CREATEED_BY CREATE_DATE CREATE_TIME CHANGED_BY CHANGE_dATE CHANGE_TIME
        INTO CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR
        FROM TKESS_SCR
        WHERE PRGNAME EQ SY-CPROG
        AND SCRNAME NE SPACE
        AND USER_SPEC EQ SPACE.

    SELECT PRGNAME TABNAME SCRNAME USER_SPEC
           CREATEED_BY CREATE_DATE CREATE_TIME CHANGED_BY CHANGE_dATE CHANGE_TIME
        APPENDING CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR
        FROM TKESS_SCR
        WHERE PRGNAME EQ SY-CPROG
          AND TABNAME EQ SY-UNAME
          AND SCRNAME NE SPACE
          AND USER_SPEC EQ 'X'.

    SELECT PRGNAME TABNAME SCRNAME LANGU SCRDESCR
    INTO CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR_DESCR
    FROM TKESS_SCR_DESCR
    WHERE PRGNAME EQ SY-CPROG
      AND LANGU EQ SY-LANGU.
    
    SORT GT_TKESS_SCR_DESCR BU PRGNAME SCRNAME LANGU.

    SELECT PRGNAME TABNAME SCRNAME TFNAME SEQUENCE
    INTO CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR_FIELD
    FROM TKESS_SCR_FIELD
    WHERE PRGNAME EQ SY-CPROG
      AND TABNAME EQ SY-UNAME
      AND SCRNAME NOT LIKG 'G_%'.

    SELECT PRGNAME TABNAME SCRNAME TFNAME SEQUENCE
    APPENDING CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR_FIELD
    FROM TKESS_SCR_FIELD
    WHERE PRGNAME EQ SY-CPROG
      AND SCRNAME LIKE 'G_%'  .
    
    SORT GT_TKESS_SCR_FIELD BY SCRNAME TFNAME.
ENDFORM.

FORM SET_VARIANT_LIST USING PV_SCRNAME.
    DATA : LT_VALUE TYPE VRM_VALUES,
    LS_VALUE LIKE LINE OF LT_VALUE,
    LV_ID TYPE VRM_ID VALUE 'PA_SCRNM'.

    SORT GT_TKESS_SCR BY USER_SPCE SCRNAME.
    LOOP AT GT_TKESS_SCR INTO DATA(LS_TKESS_SCR).
        CLEAR LS_VALUE.
        LS_VALUE-KEY = LS_TKESS_SCR-SCRNAME.
        APPEND LS_VALUE TO LT_VALUE..
    ENDLOOP.

    CALL FUNCTION 'VRM_SET_VALUES'
        EXPORTING
            ID = LV_ID
            VALUES = LT_VALUE
        EXCEPTIONS
        ...
    IF PV_SCRNAME IS INITIAL.
        CLEAR : PA_SCRNM, PA_SCRTX, GT_FIELDLIST.
    ELSE.
        PA_SCRNM = PV_SCRNAME.
        PERFORM READ_PA_SCRTX USING PA_SCRNM PA_SCRTX.
    ENDIF.

    GV_LIST_UPDATE = 'X'.
ENDFORM.

FORM SAVE_VARIANT_LIST USING PS_TKESS STRUCTURE TKESS_SCR.

    DATA : LV_VARIANT TYPE RSVAR-VARIANT,
           LV_SUBRC TYPE SY-SUBRC.
    
           LV_VARIANT = PS_TKESS-SCRNAME.

    CALL FUNCTION 'RS_VARIANT_EXISTS'
        EXPORTING
            REPORT = PS_TKESS-PRGNAME
            VARIANT = LV_VARIANT
        IMPORTING
            R_C = LV_SUBRC
        EXCEPTIONS
        ...
ENDFORM.

FORM RKE_FIELD_SELECTION_POPUP.
    DATA : LT_MAX TYPE RSELOPTION,
           LS_FLDLIST TYPE RKE_YS_FIELD_sELECTION,
           LV_MAX_COLUMNS TYPE I,
           LV_TITLE TYPE STRING.
    DATA LT_FIELDLIST LIKE GT_FIELDLIST.
    DATA LT_COLUMNS LIKE GT_COLUMNS.

    clear : gt_fieldlist, gt_columns, lt_max, lv_max_columns.

    CASE sscrfields-ucomm.
        when 'PUSHSLCR'.
         " GT_FIELDLIST 데이터를 구성한다.
            GT_FIELDLIST = GT_MAINSLCR.
            GT_COLUMNS = GT_SELESLCR.
        WHEN 'PUSHSOUR'.
          GT_FIELDLIST = GT_MAINSOUR.
          GT_COLUMNS = GT_SELESCOUR.

        WHEN 'PUSHPLIT'.
            GT_FIELDLIST = GT_MAINPLIT.
            GT_COLUMNS = GT_SELEPLIT.
    ENDCASE.

    IF GT_FIELDLIST IS INITIAL AND GT_COLUMNS IS NOT INITIAL.
        CLEAR GT_COLUMNS.
    ENDIF.

    CALL FUNCTION 'RKE_FIELD_SELECTION_POPUP'
        EXPORTING
            IT_FIELDLIST = GT_FIELDLIST
            I_MIN_COLUMNS = 1
            I_MAX_COLUMNS = LV_MAX_COLUMNS
            I_TITLE_POPUP = LV_TITLE
        CHANGING
            XT_COLUMNS = GT_COLUMNS.

    CLEAR LV_MAX_COLUMNS.
    LOOP AT GT_COLUMNS ASSIGNING FIELD-SYMBOL(<LS_COL>).
        LV_MAX_COLUMNS += 1.
        <LS_COL>-GROUP_TXT = LV_MAX_COLUMNS.
    ENDLOOP.

    SORT : GT_FIELDLIST BY FNAM, GT_COLUMNS BY FNAM.

    CASE SSCRFIELDS-UCOMM.
        WHEN 'PUSHSLCR'.
            GT_SELESLCR = GT_COLUMNS.
        WHEN 'PUSHSOUR'.
            GT_SELESOUR = GT_COLUMNS.
        WHEN 'PUSHPLIT'.
            GT_SELEPLIT = GT_COLUMNS.
    ENDCASE.
ENDFORM.

FORM READ_PA_SCRTX.
ENDFORM.

FORM SET_SCREEN_UCOMM.
    CLEAR GV_LIST_UPDATE.

    CASE SSCRFIELDS-UCOMM.
        WHEN 'PUSHSLCR' OR " CHARACTERISTICS
             'PUSHSOUR' OR " SOURCE CATEGORY
             'PUSHPLIT'.   " P/L ITEM
            PERFORM SCREEN_1000_PUSH_BTN.
            CLEAR : PA_SCRNM, GS_TKESS-SCRNAME.
        WHEN 'PUSHSAVE'.
            PERFORM SCREEN_1000_PUSHSAVE.
        WHEN 'PUSHMANA'.
            PERFORM SCREEN_1000_PUSHMANA.
        WHEN 'SCRNM'.
            IF PA_SCRNM IS INITIAL.
                CLEAR : GT_sELESOUR, GT_SELESLCR, GT_sELEPLIT.
                GS_TKESS-SCRNAME = PA_SCRNM.
            ENDIF.
            PERFORM SCREEN_1000_SCRNM.
        WHEN 'ONLI'.
            IF GT_sELESOUR IS INITIAL AND
               GT_SELESLCR IS INITIAL AND
               GT_SELEPLIT IS INITIAL.
               PERFORM MAKE_GT_COLUMNS.
            ENDIF.
    ENDCASE.
ENDFORM.

FORM SCREEN_1000_PUSHSAVE.
    DATA : LT_FIELDSEQ TYPE KESS_YT_FIELD_SEQUENCE,
           LS_FIELDSEQ TYPE KESS_YS_FIELD_SEQUENCE.
    
    CLEAR LT_FIELDSEQ.

    GS_TKESS-PRGNAME = SY-CPROG.
    GS_TKESS-TABNAME = SY-UNAME.
    GT_TKESS-SCRNAME = SPACE.
    GS_TKESS-USER_SPEC = 'X'.
    GS_TKESS-CREATED_BY = SY-UNAME.

    LOOP AT GT_sELECSOUR INTO DATA(LS_COLUMNS).
        CLEAR LS_FIELDSEQ.
        LS_FIELDSEQ-TFNAME = LS_COLUMNS-FNAM.
        APPEND LS_FIELDSEQ TO LT_FIELDSEQ.
    ENDLOOP.

    LOOP AT GT_sELECSLCR INTO LS_COLUMNS.
        CLEAR LS_FIELDSEQ.
        LS_FIELDSEQ-TFNAME = LS_COLUMNS-FNAM.
        APPEND LS_FIELDSEQ TO LT_FIELDSEQ.
    ENDLOOP.

    LOOP AT GT_sELECPLIT INTO LS_COLUMNS.
        CLEAR LS_FIELDSEQ.
        LS_FIELDSEQ-TFNAME = LS_COLUMNS-FNAM.
        APPEND LS_FIELDSEQ TO LT_FIELDSEQ.
    ENDLOOP.    

    IF LT_FIELDSEQ IS INITIAL.
        "ERROR. SELECT A CHARATERISTIC FIRST.
        STOP.
    ENDIF.

    CALL FUNCTION 'YKESS_SAVE_SCREEN'
        EXPORTING
            IT_SS_SF = LT_FIELDSEQ
        CHANGING
            CS_SCR = GS_TKESS.
    
    IF GS_TKESS-SCRNAME IS INITIAL.
        GS_TKESS-SCRNAME = PA_SCRNM.
    ELSE.
        PA_SCRNM = GS_TKESS-SCRNAME.
    ENDIF.

    GV_LIST_UPDATE = 'X'.
ENDFORM.

FORM SCREEN_1000_SCRNM.
    IF ( PA_SCRNM NE GS_TKESS-SCRNAME ) AND PASCRNM IS NOT INITIAL.
        CLEAR : GT_SELESOUR, GT_sELESLCR, GT_SELEPLIT.
        GS_TKESS-SCRNAME = PA_SCRNM.
    ENDIF.

    PERFORM READ_PA_SCRTX USING PA_sCRNM PA_SCRTX.
    PERFORM MAKE_GT_COLUMNS.

    GV_LIST_UPDATE = 'X'.
ENDFORM.

FORM SCREEN_1000_PUSH_BTN.
    PERFORM MAKE_GT_COLUMNS.
    PERFORM RKE_FIELD_SELECTION_POPUP.
ENDFORM.

FORM SCREEN_1000_PUSHMANA.
    PERFORM GET_VARIANT_DATA.
    PERFORM MODIFY_POPUP_DATA.
    PERFORM CREATE_POPUP_ALV.
ENDFORM.

FORM REFRESH_PA_SCRNM.
    PERFORM GET_VARIANT_dATA.
    PERFORM SET_VARIANT_LIST USING PA_SCRNM.
    PERFORM SAVE_VARIANT_LIST USING GS_TKESS.

    LOOP AT SCREEN.
        CASE SCREEN-NAME.
            WHEN 'PA_SCRNM'.
            WHEN OTHERS.
                CONTINUE.
        ENDCASE.
        MODIFY SCREEN.
    ENDLOOP.
ENDFORM.

FORM SCREEN_DELETE USING PV_SCRNAME TYPE TKESS_SCR-SCRNAME
                         PV_ALL_LANGU TYPE FLAG.
    IF PV_ALL_LANGU EQ SPACE.
        DELETE FROM TKESS_SCR_DESCR
        WHERE PRGNAME EQ SY-CPROG
          AND TABNAME EQ SY-UNAME
          AND SCRNAME EQ PV_SCRNAME
          AND LANGU EQ SY-LANGU.
    ELSE.
        DELETE FROM TKESS_SCR_DESCR
        WHERE PRGNAME EQ SY-CPROG
          AND TABNAME EQ SY-UNAME
          AND SCRNAME EQ PV_SCRNAME.
    ENDIF.

    SELECT SINGLE MANDT, PRGNAME, TABNAME, USERNAME, SCRNAME, VARNAME
    FROM TKESS_SCR_INIT
    WHERE PRGNAME EQ @SY-CPROG
      AND TABNAME EQ @SY-UNAME
      AND SCRNAME EQ @PV_SCRNAME
      INTO @DATA(LS_INIT).
    IF SY-SUBRC EQ 0.
        IF LS_INIT-VARNAME IS INITIAL.
            DELETE FROM TKESS_SCR_INIT
                WHERE PRGNAME EQ SY-CPROG
                  AND TABNAME EQ SY-UNAME
                  AND SCRNAME EQ PV_SCRNAME.
        ELSE.
            CLEAR LS_INIT-SCRNAME.
            MODIFY TKESS_SCR_INIT FROM LS_INIT.
        ENDIF.
    ENDIF.

    DELETE FROM TKESS_SCR_FIELD
        WHERE PRGNAME EQ SY-CPROG
          AND TABNAME EQ SY-UNAME
          AND SCRNAME EQ PV_SCRNAME.

    DELETE FROM TKESS_SCR_FIELD
        WHERE PRGNAME EQ SY-CPROG
          AND TABNAME EQ SY-UNAME
          AND SCRNAME EQ PV_SCRNAME.

    COMMIT WORK.
ENDFORM.

FORM CREATE_POPUP_ALV.
DATA : LRF_COLUMNS TYPE REF TO CL_SALV_COLUMNS_TABLE,
       LRF_COLUMN TYPE REF TO CL_SALV_COLUMN_TABLE,
       LRF_DS TYPE REF TO CL_SALV_DISPLAY_SETTINGS,
       LRF_HANDLER_MANA TYPE REF TO LCL_HANDLER_MANA,
       LRF_SELECTIONS TYPE REF TO CL_SALV_SELECTIONS,
       LRF_ALV_FUNC TYPE REF TO CL_SALV_FUNCTIONS_LIST,
       LRF_EVENTS TYPE REF TO CL_SALV_EVENTS_TABLE,
       LS_COLOR TYPE LVC_S_COLO.

    SY-TITLE =  'TITLE'.

    TRY.
        CALL MTEHOD CL_SALV_TABLE=>FACTORY
            IMPORTING
                R_SALV_TABLE = GRF_MANAGE_ALV
            CHANGING
                T_TABLE = GT_SCR_MANAGE.
    CATCH CX_SLAV_MSG INTO DATA(LO_SALV_MSG).
    ENDTRY.

    TRY.
        LRF_COLUMNS = GRF_MANAGE_ALV->GET_COLUMNS(  ).

        LRF_COLUMN ?= LRF_COLUMNS->GET_COLUMN( 'SCRDELE' ).
        LRF_COLUMN->SET_TECHNICAL( ABAP_TRUE  ).

        LRF_COLUMN ?= LRF_COLUMNS->GET_COLUMN( 'DEFAGLOB' ).
        LRF_COLUMN->SET_TECHNICAL( ABAP_TRUE  ).
        
        LRF_COLUMN ?= LRF_COLUMNS->GET_COLUMN( 'DEFAUSER' ).
        LRF_COLUMN->SET_TECHNICAL( ABAP_TRUE  ).
        
        LRF_COLUMN ?= LRF_COLUMNS->GET_COLUMN( 'USER_SPEC' ).
        LRF_COLUMN->SET_ICON( ABAP_TRUE  ).        
        LRF_COLUMN->SET_OUTPUT_LENGTH( 8 ).        
    CATCH CX_SALV_NOT_FOUND INTO DATA(LO_SALV_NOT_FOUND).
    ENDTRY.

    LRF_DS = GRF_MANAGE_ALV->GET_DISPLAY_SETTINGS().
    LRF_DS->SET_STRIPED_PATTERN( ABAP_TRUE ).

    GRF_MANAGE_ALV-<SET_SCREEN_POPUP( START_COLUMN = 10
                                      END_COLUMN = 100
                                      START_LINE = 5
                                      END_LINE = 15 ).

    LRF_ALV_FUNC  = GRF_MANAE_ALV->GET_FUNCTIONS()..
    LRF_ALV_FUNC-> SET_ALL( ABAP_TRUE )                                      .

    LRF_sELECTIOS = GRF_MANAGE_ALV->GET_SELECTIONS().
    LRF_SELECTIONS->SET_SELECTION_MODE( LRF_SELECTIONS->MULTIPLE ).
    LRF_SELECTIONS->SET_SELECTION_MODE( IF_SALV_C_SELECTION_MODE=>NONE ).

    LRF_EVENTS = GRF_MANAGE_ALV->GET_EVENT().

    CREATE OBJECT LRF_HANDLER_MANA.
    SET HANDLER LRF_HANDLER_MANA->ADDED_FUNCTION FOR LRF_EVENTS.

    GRF_MANAGE_ALV->SET_SCREEN_STATUS( PFSTATUS = 'SALV_POPUP_XXX'
                                       REPORT = 'SAPLXXXXX' 
                                       SET_FUNCTIONS = GRF_MANAGE_ALV->C_FUNCTIONS_ALL ).

    GRF_MANAGE_ALV->DISPLAY(  ).

    IF  GV_LIST_UPDATE = 'X'.
        PERFORM GET_VARIANT_DATA.
        PERFORM SET_VARIANT_LIST USING ''
        CLEAR :GT_SELESOUR, GT_SELESLCR, GT_SELEPLIT.
    ENDIF.
ENDFORM.

FORM MODIFY_POPUP_DATA.
    CLEAR GT_SCR_MANAGE.

    GT_SCR_MANAGE = CORRESPONDING #( GT_TKESS_SCR ).
    LOOP AT GT_SCR_MANAGE INTO DATA(LS_SCR_MANAGE).
        DATA(LV_TABIX) = SY-TABIX.

        PERFORM READ_PA_SCRTX USING LS_SCR_MANAGE-SCRNAME LS_SCR_MANAGE-SCRDESCR.
        MODIFY GT_SCR_MANAGE FROM LS_SCR_MANAGE INDEX LV_TABIX TRANSPORTING SCRDESCR.
    ENDLOOP.

    SORT GT_SCR_MANAGE BY USER_SPCE SCRNAME.
ENDFORM.

FORM GET_DEFAULT_VALUE.
    DATA LT_DEF_SLCR TYPE RSELOPTION.

    IF GT_DEFASLCR IS INITIAL.
        " LT_DEF_SLCR에 데이터(특성)을 채워주는 로직

        LOOP AT LT_dEF_SLCR INTO DATA(LS_DEF_SLCR).
            READ TABLE GT_MAINSLCR INTO DATA(LS_MAINSLCR) WITH KEY FNAM = LS_DEF_SLCR-LOW BINARY SEARCH.
            IF SY-SUBRC EQ 0.
                LS_MAINSLCR-TABNAME = SY-UNAME.
                APPEND LS_MAINSLCR TO GT_DEFASLCR.
            ENDIF.
        ENDLOOP.
    ENDIF.
ENDFORM.

FORM SET_BASIC_FIELD.
    IF GT_SELESOUR[] IS INITIAL.
        GT_SELESOUR = VALUE #( FOR WA_DEFASOUR IN GT_DEFASOUR ( CORRESPONDING #( WA_DEFASOUR ) ) ).
    ENDIF.    

    IF GT_SELESLCR[] IS INITIAL.
        GT_SELESLCR = VALUE #( FOR WA_DEFASLCR IN GT_DEFASLCR ( CORRESPONDING #( WA_DEFASLCR ) ) ).
    ENDIF.

    IF GT_SELEPLIT[] IS INITIAL.
        GT_SELEPLIT = VALUE #( FOR WA_DEFAPLIT IN GT_DEFAFLIT ( CORRESPONDING #( WA_DEFAFLIT ) ) ).
    ENDIF.

    SORT : GT_SELESCOUR BY FNAME, GT_sELESLCR BY FNAM,GT_SELEPLIT BY FNAM.
ENDFORM.

FORM CREATE_ICON_1000.
    _G_ICON_CRE : ICON_ALV_VARIANTS 'CHARACTERISTICS' 'CHARACTERISTICS' PUSHSLCR,
                  ICON_ALV_VARIANTS 'SOURCE CATEGORY' 'SOURCE CATEGORY' PUSHSOUR,
                  ICON_ALV_VARIANTS 'P/L ITEM' 'P/L ITEM' PUSHPLIT,
                  ICON_ALV_VARIANT_SAVE SPACE 'SAVE SELECTION SCREEN' PUSHSAVE,
                  ICON_WORKING_PLAN SPACE 'MANAGE SELECTION SCREENS' PUSHMANA.
ENDFORM.

FORM IMPORT_MEMORY_1000.
    IMPORT GT_sELESLCR[] FROM MEMORY ID 'GT_SELESLCR'.
    IMPORT GT_sELESOUR[] FROM MEMORY ID 'GT_SELESOUR'.
    IMPORT GT_sELEPLIT[] FROM MEMORY ID 'GT_SELESPLIT'.

    IMPORT GT_FIELDLIST[] FROM MEMORY ID 'GT_FIELDLIST'.
    IMPORT GT_COLUMNS[] FROM MEMORY ID 'GT_COLUMNS'.

    IMPORT GS_TKESS FROM MEMORY ID 'GS_TKESS'.

    IF PA_SCRNM IS INITIAL.
        IMPORT PA_SCRNM FROM MEMORY ID 'PA_SCRNM'.
    ENDIF.

    FREE MEMORY ID 'GT_SELESLCR'.
    FREE MEMORY ID 'GT_SELESOUR'.
    FREE MEMORY ID 'GT_SELEPLIT'.
    FREE MEMORY ID 'GT_FIELDLIST'.
    FREE MEMORY ID 'GT_COLUMNS'.
    FREE MEMORY ID 'PA_SCRNM'.
    FREE MEMORY ID 'GS_TKESS'.
ENDFORM.

FORM EXPORT_MEMORY_1000.
    EXPORT GT_SELESLCR[] TO MEMORY ID 'GT_SELESLCR'.
    EXPORT GT_SELESOUR[] TO MEMORY ID 'GT_SELESOUR'.
    EXPORT GT_SELEPLIT[] TO MEMORY ID 'GT_SELEPLIT'.
    EXPORT GT_FIELDLIST[] TO MEMORY ID 'GT_FIELDLIST'.
    EXPORT GT_COLUMNS[] TO MEMORY ID 'GT_COLUMNS'.
    EXPORT PA_SCRNM[] TO MEMORY ID 'PA_SCRNM'.
    EXPORT GS_TKESS[] TO MEMORY ID 'GS_TKESS'.
ENDFORM.

FORM CHECK_VARIANT_1000.
    IF PA_SCRNM IS NOT INITAL.
        SORT GT_TKESS_SCR BY SCRNAME TABNAME.
        READ TABLE GT_TKESS_SCR TRANSPORTING NO FIELDS WITH KEY SCRNAME = PA_SCRNM TABNAME = SY-UNAME BINARY SEARCH.
        IF SY-SUBRC NE 0.
            SORT GT_TKESS_SCR BY SCRNAME USER_SPCE.
            READ TABLE GT_TEKSS_SCR TRANSPORTING NO FIELDS WITH KEY SCRNAME = PA_sCRNM USER_SPEC = SPACE BINARY SEARCH.
            IF SY-SUBRC NE 0.
                "ERROR/
                STOP.
            ENDIF.
        ENDIF.
    ENDIF.
ENDFORM.

FORM MAKE_MAIN_DATA_1000.
    DATA : LS_COLUMNS TYPE RKE_YS_FIELD_SELECTION,
           LV_FLDNAME TYPE FIELDNAME,
           LV_OLD TYPE ABAP_BOOL.
    
    CLEAR LV_OLD.

    IF GT_SELESOUR IS NOT INITIAL OR
       GT_SELESLCR IS NOT INITIAL OR
       GT_SELEPLIT IS NOT INITIAL.
       LV_OLD = 'X'.
    ENDIF.

    IF GT_MAINSLCR IS INITAIL.
        LOOP AT GT_CLIST_1000 INTO DATA(LS_CLIST).
            CLEAR LS_COLUMNS.
            LS_COLUMNS-FNAM = LS_CLIST-CHART.
            LS_COLUMNS-TEXT = LS_CLIST-DSTXT.
            APPEND LS_COLUMNS TO GT_MAINSLCR.
        ENDLOOP.
    ENDIF.

    SORT : GT_MAINSOUR BY FNAM, GT_MAINSLCR BY FNAM, GT_MAINPLIT BY FNAM.

    IF LV_OLD IS INITAL AND PA_SCRNNM IS NOT INITIAL.
        LOOP AT GT_TKESS_SCR_FIELD FROM 1 INTO DATA(LS_TKESS_SCR_FIELD) WHERE SCRNAME EQ PA_SCRNM.
            IF LS_TKESS_SCR_FIELD-SCRNAME NE PA_SCRNM.
                EXIT.
            ENDIF.

            LV_FLDNAME = LS_TKESS_SCR_FIELD-TFNAME(30).

            READ TABLE GT_MAINSOUR INTO LS_COLUMNS WITH KEY FNAM = LV_FLDNAME BINARY SEARCH.
            IF SY-SUBRC EQ 0.
                APPEND LS_COLUMNS TO GT_sELESOUR.
            ENDIF.

            READ TABLE GT_MAINSLCR INTO LS_COLUMNS WITH KEY FNAM = LV_FLDNAME BINARY SEARCH.
            IF SY-SUBRC EQ 0.
                APPEND LS_CO,UMNS TO GT_SELESLCR.

                " 변형이 입력된 경우 디폴트 특성도 체크.
            ELSEIF SY-SUBRC NE 0.
                READ TABLE GT_DEFASLCR INTO LS_COLUMNS WITH KEY ZSKEY COMPONENTS FNAM = LV_FLDNAME.
                IF SY-SUBRC EQ 0.
                    APPEND LS_COLUMNS TO GT_sELSLCR.
                ENDIF.
            ENDIF.

            READ TABLE GT_MAINPLIT INTO LS_COLUMNS WITH KEY FNAM = LV_FLDNAME BINARY SEARCH.
            IF SY-SUBRC EQ 0.
                APPEND LS_COLUMNS TO GT_SELEPLIT.
            ENDIF.
        ENDLOOP.
    ENDIF.
ENDFORM.

FORM MAKE_GT_COLUMNS.
    PERFORM GET_VARIANT_DATA.
    PERFORM CHECK_VARIANT_1000.
    PERFORM MAKE_MAIN_DATA_1000.
    PERFORM GET_DEFAULT_VALUE. " 디폴트 정보 추출.    
    PERFORM SET_BASIC_FIELD. " 선택된 값이 없을 경우 디폴트 값 세팅
ENDFORM.




    














    
