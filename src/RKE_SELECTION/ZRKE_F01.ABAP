FORM SECREEN_1000_ADD_CBTN.
    
    PERFORM CREATE_ICON_1000.
    
    PERFORM IMPORT_MEMORY_1000.
    
    PERFORM GET_VARIANT_DATA.
    
    PERFORM SET_VARIANT_LIST USING GV_SCRNAME.

    PERFORM MAKE_GT_COLUMNS.
ENDFORM.

FORM ICON_CREATE USING PV_NAME PV_TEXT PV_INFO PV_RESULT.
    CALL FUNCTION 'ICON_CREATE'
        EXPORTING
            NAME = PV_NAME
            TEXT = PV_TEXT
            INFO = PV_INFO
            ADD_STDINF = ' '
        IMPORTING  
            RESULT = PV_RESULT
        EXCEPTIONS
            ...
ENDFORM.

FORM GET_VARIANT_dATA.
    CLEAR : GT_TKESS_sCR, GT_TKESS_SCR_DESCR, GT_TKESS_SCR_FIELD.

    SELECT PRGNAME TABNAME SCRNAME USER_SPEC
           CREATEED_BY CREATE_DATE CREATE_TIME CHANGED_BY CHANGE_dATE CHANGE_TIME
        INTO CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR
        FROM TKESS_SCR
        WHERE PRGNAME EQ SY-CPROG
        AND SCRNAME NE SPACE
        AND USER_SPEC EQ SPACE.

    SELECT PRGNAME TABNAME SCRNAME USER_SPEC
           CREATEED_BY CREATE_DATE CREATE_TIME CHANGED_BY CHANGE_dATE CHANGE_TIME
        APPENDING CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR
        FROM TKESS_SCR
        WHERE PRGNAME EQ SY-CPROG
          AND TABNAME EQ SY-UNAME
          AND SCRNAME NE SPACE
          AND USER_SPEC EQ 'X'.

    SELECT PRGNAME TABNAME SCRNAME LANGU SCRDESCR
    INTO CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR_DESCR
    FROM TKESS_SCR_DESCR
    WHERE PRGNAME EQ SY-CPROG
      AND LANGU EQ SY-LANGU.
    
    SORT GT_TKESS_SCR_DESCR BU PRGNAME SCRNAME LANGU.

    SELECT PRGNAME TABNAME SCRNAME TFNAME SEQUENCE
    INTO CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR_FIELD
    FROM TKESS_SCR_FIELD
    WHERE PRGNAME EQ SY-CPROG
      AND TABNAME EQ SY-UNAME
      AND SCRNAME NOT LIKG 'G_%'.

    SELECT PRGNAME TABNAME SCRNAME TFNAME SEQUENCE
    APPENDING CORRESPONDING FIELDS OF TABLE GT_TKESS_SCR_FIELD
    FROM TKESS_SCR_FIELD
    WHERE PRGNAME EQ SY-CPROG
      AND SCRNAME LIKE 'G_%'  .
    
    SORT GT_TKESS_SCR_FIELD BY SCRNAME TFNAME.
ENDFORM.

FORM SET_VARIANT_LIST USING PV_SCRNAME.
    DATA : LT_VALUE TYPE VRM_VALUES,
    LS_VALUE LIKE LINE OF LT_VALUE,
    LV_ID TYPE VRM_ID VALUE 'PA_SCRNM'.

    SORT GT_TKESS_SCR BY USER_SPCE SCRNAME.
    LOOP AT GT_TKESS_SCR INTO DATA(LS_TKESS_SCR).
        CLEAR LS_VALUE.
        LS_VALUE-KEY = LS_TKESS_SCR-SCRNAME.
        APPEND LS_VALUE TO LT_VALUE..
    ENDLOOP.

    CALL FUNCTION 'VRM_SET_VALUES'
        EXPORTING
            ID = LV_ID
            VALUES = LT_VALUE
        EXCEPTIONS
        ...
    IF PV_SCRNAME IS INITIAL.
        CLEAR : PA_SCRNM, PA_SCRTX, GT_FIELDLIST.
    ELSE.
        PA_SCRNM = PV_SCRNAME.
        PERFORM READ_PA_SCRTX USING PA_SCRNM PA_SCRTX.
    ENDIF.

    GV_LIST_UPDATE = 'X'.
ENDFORM.

FORM SAVE_VARIANT_LIST USING PS_TKESS STRUCTURE TKESS_SCR.

    DATA : LV_VARIANT TYPE RSVAR-VARIANT,
           LV_SUBRC TYPE SY-SUBRC.
    
           LV_VARIANT = PS_TKESS-SCRNAME.

    CALL FUNCTION 'RS_VARIANT_EXISTS'
        EXPORTING
            REPORT = PS_TKESS-PRGNAME
            VARIANT = LV_VARIANT
        IMPORTING
            R_C = LV_SUBRC
        EXCEPTIONS
        ...
ENDFORM.

FORM RKE_FIELD_SELECTION_POPUP.
    DATA : LT_MAX TYPE RSELOPTION,
           LS_FLDLIST TYPE RKE_YS_FIELD_sELECTION,
           LV_MAX_COLUMNS TYPE I,
           LV_TITLE TYPE STRING.
    DATA LT_FIELDLIST LIKE GT_FIELDLIST.
    DATA LT_COLUMNS LIKE GT_COLUMNS.

    clear : gt_fieldlist, gt_columns, lt_max, lv_max_columns.

    CASE sscrfields-ucomm.
        when 'PUSHSLCR'.
         " GT_FIELDLIST 데이터를 구성한다.
            GT_FIELDLIST = GT_MAINSLCR.
            GT_COLUMNS = GT_SELESLCR.
        WHEN 'PUSHSOUR'.
          GT_FIELDLIST = GT_MAINSOUR.
          GT_COLUMNS = GT_SELESCOUR.

        WHEN 'PUSHPLIT'.
            GT_FIELDLIST = GT_MAINPLIT.
            GT_COLUMNS = GT_SELEPLIT.
    ENDCASE.

    IF GT_FIELDLIST IS INITIAL AND GT_COLUMNS IS NOT INITIAL.
        CLEAR GT_COLUMNS.
    ENDIF.

    CALL FUNCTION 'RKE_FIELD_SELECTION_POPUP'
        EXPORTING
            IT_FIELDLIST = GT_FIELDLIST
            I_MIN_COLUMNS = 1
            I_MAX_COLUMNS = LV_MAX_COLUMNS
            I_TITLE_POPUP = LV_TITLE
        CHANGING
            XT_COLUMNS = GT_COLUMNS.

    CLEAR LV_MAX_COLUMNS.
    LOOP AT GT_COLUMNS ASSIGNING FIELD-SYMBOL(<LS_COL>).
        LV_MAX_COLUMNS += 1.
        <LS_COL>-GROUP_TXT = LV_MAX_COLUMNS.
    ENDLOOP.

    SORT : GT_FIELDLIST BY FNAM, GT_COLUMNS BY FNAM.

    CASE SSCRFIELDS-UCOMM.
        WHEN 'PUSHSLCR'.
            GT_SELESLCR = GT_COLUMNS.
        WHEN 'PUSHSOUR'.
            GT_SELESOUR = GT_COLUMNS.
        WHEN 'PUSHPLIT'.
            GT_SELEPLIT = GT_COLUMNS.
    ENDCASE.
ENDFORM.

FORM READ_PA_SCRTX.
ENDFORM.

FORM SET_SCREEN_UCOMM.
    CLEAR GV_LIST_UPDATE.

    CASE SSCRFIELDS-UCOMM.
        WHEN 'PUSHSLCR' OR " CHARACTERISTICS
             'PUSHSOUR' OR " SOURCE CATEGORY
             'PUSHPLIT'.   " P/L ITEM
            PERFORM SCREEN_1000_PUSH_BTN.
            CLEAR : PA_SCRNM, GS_TKESS-SCRNAME.
        WHEN 'PUSHSAVE'.
            PERFORM SCREEN_1000_PUSHSAVE.
        WHEN 'PUSHMANA'.
            PERFORM SCREEN_1000_PUSHMANA.
        WHEN 'SCRNM'.
            IF PA_SCRNM IS INITIAL.
                CLEAR : GT_sELESOUR, GT_SELESLCR, GT_sELEPLIT.
                GS_TKESS-SCRNAME = PA_SCRNM.
            ENDIF.
            PERFORM SCREEN_1000_SCRNM.
        WHEN 'ONLI'.
            IF GT_sELESOUR IS INITIAL AND
               GT_SELESLCR IS INITIAL AND
               GT_SELEPLIT IS INITIAL.
               PERFORM MAKE_GT_COLUMNS.
            ENDIF.
    ENDCASE.
ENDFORM.










    
